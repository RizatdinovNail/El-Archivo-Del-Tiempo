      "inventoryIsUsable": true
    },
    {
      "key": "slot3",
      "speaker": "Carmen",
      "portrait": "abuela",
      "expression": "feliz",
      "text": "Anda, come un poco antes de seguir. No puedes trabajar con el estómago vacío.",
