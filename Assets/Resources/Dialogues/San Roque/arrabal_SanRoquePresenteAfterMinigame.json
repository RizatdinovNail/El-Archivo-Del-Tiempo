    },
    {
      "key": "slot3",
      "speaker": "Juan Solsona",
      "portrait": "juan_solsona",
      "expression": "feliz",
      "text": "Pues que iba hacia el ayuntamiento, con paso decidido. Y algo se le cayó… parecía un papel doblado.",
      "seen": false,
      "mapIsObtained": false,
      "inventoryIsUsable": true
    },
    {
      "key": "slot1",
      "speaker": "Bella",
      "portrait": "bella",
      "expression": "feliz",
      "text": "¿Y aún lo tiene?",
      "seen": false,
      "mapIsObtained": false,
      "inventoryIsUsable": true
    },
    {
      "key": "slot3",
      "speaker": "Juan Solsona",
      "portrait": "juan_solsona",
      "expression": "feliz",
      "text": "Claro, pensé que era un recibo viejo. Aquí lo tengo.",
      "seen": false,
      "mapIsObtained": false,
      "inventoryIsUsable": true
    },
    {
      "key": "slot1",
      "speaker": "Bella",
      "portrait": "bella",
      "expression": "feliz",
      "text": "Gracias, esto puede ser importante.",
      "seen": false,
      "mapIsObtained": false,
      "inventoryIsUsable": true
    },
    {
      "key": "slot3",
      "speaker": "Juan Solsona",
      "portrait": "juan_solsona",
      "expression": "feliz",
      "text": "Bueno, si resuelves el misterio, acuérdate de volver por aquí.",
