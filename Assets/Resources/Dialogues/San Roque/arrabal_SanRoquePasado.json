      "mapIsObtained": false,
      "inventoryIsUsable": false
    },
    {
      "key": "slot3",
      "speaker": "Juanjo Colom",
      "portrait": "",
      "expression": "feliz",
      "text": "Yo tengo que vigilar toda esta zona y me vendría bien un poco de ayuda.",
