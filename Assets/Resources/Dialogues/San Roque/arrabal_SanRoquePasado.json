      "mapIsObtained": false,
      "inventoryIsUsable": false
    },
    {
      "key": "slot3",
      "speaker": "Juanjo Colom",
      "portrait": "",
      "expression": "feliz",
      "text": "Debes tener ojos atentos, ¿podrías ayudarme?",
      "seen": false,
      "mapIsObtained": false,
      "inventoryIsUsable": false
    },
    {
      "key": "slot1",
      "speaker": "Bella",
      "portrait": "bella",
      "expression": "feliz",
      "text": "Sí, te ayudo. ¿Qué tengo que hacer?",
      "seen": false,
      "mapIsObtained": false,
      "inventoryIsUsable": false
    },
    {
      "key": "slot3",
      "speaker": "Juanjo Colom",
      "portrait": "",
      "expression": "feliz",
      "text": "Algunos vecinos se aventuran demasiado lejos y debemos asegurarnos de que respeten los límites.",
      "seen": false,
      "mapIsObtained": false,
      "inventoryIsUsable": false
    },
    {
      "key": "slot3",
      "speaker": "Flecha",
